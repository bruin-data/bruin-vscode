{
    "scopeName": "sql.comment.block",
    "injectionSelector": "L:source.sql, L:source.sql-bigquery, L:source.pgsql",
    "patterns": [
        {
            "include": "#jinja-comment"
        },
        {
            "include": "#bruin-sql"
        }
    ],
    "repository": {
        "jinja-comment": {
            "name": "comment.block.jinja.bruin",
            "begin": "\\{#-?",
            "end": "-?#\\}",
            "patterns": []
        },
        "bruin-sql": {
            "name": "bruin-sql",
            "patterns": [
                {
                    "include": "source.yaml"
                }
            ],
            "begin": "(\\/\\*\\s*@bruin)\\s*$",
            "end": "(@bruin\\s*\\*/)\\s*$",
            "beginCaptures": {
                "1": {
                    "name": "comment"
                }
            },
            "endCaptures": {
                "1": {
                    "name": "comment"
                }
            }
        }
        
    }
}